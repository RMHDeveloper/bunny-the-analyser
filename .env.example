DASHBOARD_PROXY_URL=https://30-apps-dashboard.thermh.in
DASHBOARD_PROXY_SECRET=your-shared-secret-here

# Optional model overrides. The dashboard proxy holds the actual provider API
# key(s); this app only sends a model name in the request body shape.
GEMINI_MODEL=gemini-flash-latest
OPENROUTER_MODEL=z-ai/glm-5.2:free

# Optional: restrict which origins may call /api/analyze.
ALLOWED_ORIGINS=
